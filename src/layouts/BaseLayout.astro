---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { siteConfig } from "@/config/site";
import { absoluteUrl, canonicalUrl as normalizeCanonicalUrl } from "@/lib/format";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
  profilePage?: boolean;
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  tags?: string[];
}

const {
  title,
  description = siteConfig.siteDescription,
  canonical = Astro.url.pathname,
  image,
  type = "website",
  profilePage = false,
  publishedTime,
  modifiedTime,
  tags = [],
} = Astro.props;

const pageTitle = title ? `${title} | ${siteConfig.siteTitle}` : `${siteConfig.siteTitle} | ${siteConfig.tagline}`;
const pageCanonical = normalizeCanonicalUrl(canonical);
const socialImage = image
  ? image.startsWith("http")
    ? image
    : absoluteUrl(image)
  : undefined;
const authorId = absoluteUrl("/about/#author");
const webSiteId = absoluteUrl("/#website");
const authorProfilePageId = `${siteConfig.author.url}#webpage`;
const pageId = `${pageCanonical}#webpage`;
const publishedIso = publishedTime ? new Date(publishedTime).toISOString() : undefined;
const modifiedIso = modifiedTime ? new Date(modifiedTime).toISOString() : publishedIso;
const baseStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": webSiteId,
      url: absoluteUrl("/"),
      name: siteConfig.siteTitle,
      description: siteConfig.siteDescription,
      inLanguage: "en-AU",
      author: {
        "@id": authorId,
      },
      publisher: {
        "@id": authorId,
      },
    },
    {
      "@type": "Person",
      "@id": authorId,
      name: siteConfig.author.name,
      jobTitle: siteConfig.author.role,
      url: siteConfig.author.url,
      sameAs: siteConfig.author.sameAs,
      mainEntityOfPage: {
        "@id": authorProfilePageId,
      },
    },
    {
      "@type": profilePage ? "ProfilePage" : "WebPage",
      "@id": pageId,
      url: pageCanonical,
      name: pageTitle,
      description,
      inLanguage: "en-AU",
      isPartOf: {
        "@id": webSiteId,
      },
      author: {
        "@id": authorId,
      },
      about: profilePage ? { "@id": authorId } : undefined,
      mainEntity: profilePage ? { "@id": authorId } : undefined,
    },
  ],
};
const goatcounter = import.meta.env.PUBLIC_GOATCOUNTER_CODE;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfaf6" />
    <script is:inline>
      (() => {
        const storageKey = "dtkmn-theme";
        const root = document.documentElement;
        const themeColor = {
          dark: "#030303",
          light: "#fbfaf6",
        };
        let storedTheme = null;

        try {
          storedTheme = localStorage.getItem(storageKey);
        } catch {
          storedTheme = null;
        }

        const theme = storedTheme === "light" || storedTheme === "dark" ? storedTheme : "light";
        root.dataset.theme = theme;
        root.style.colorScheme = theme;

        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) {
          meta.setAttribute("content", themeColor[theme]);
        }
      })();
    </script>
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="googlebot" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={pageCanonical} />
    <link rel="author" href={siteConfig.author.url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content={siteConfig.siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={pageCanonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {type === "article" && <meta property="article:author" content={siteConfig.author.url} />}
    {type === "article" && publishedIso && <meta property="article:published_time" content={publishedIso} />}
    {type === "article" && modifiedIso && <meta property="article:modified_time" content={modifiedIso} />}
    {type === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <link rel="alternate" type="application/rss+xml" title="Daniel Tse RSS" href="/feed.xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(baseStructuredData)}></script>
    {goatcounter && (
      <script
        is:inline
        data-goatcounter={`https://${goatcounter}.goatcounter.com/count`}
        async
        src="//gc.zgo.at/count.js"
      ></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="page-shell">
      <div class="page-noise" aria-hidden="true"></div>
      <div class="page-grid">
        <SiteHeader />
        <main id="main-content" class="page-main">
          <slot />
        </main>
        <SiteFooter />
      </div>
    </div>
    <script is:inline>
      (() => {
        const storageKey = "dtkmn-theme";
        const root = document.documentElement;
        const themeColor = {
          dark: "#030303",
          light: "#fbfaf6",
        };

        const getStoredTheme = () => {
          try {
            const value = localStorage.getItem(storageKey);
            return value === "light" || value === "dark" ? value : null;
          } catch {
            return null;
          }
        };

        const applyTheme = (theme, persist) => {
          root.dataset.theme = theme;
          root.style.colorScheme = theme;

          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) {
            meta.setAttribute("content", themeColor[theme]);
          }

          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            const nextTheme = theme === "dark" ? "light" : "dark";
            const label = `Switch to ${nextTheme} mode`;
            button.setAttribute("aria-label", label);
            button.setAttribute("title", label);
          });

          if (persist) {
            try {
              localStorage.setItem(storageKey, theme);
            } catch {
              // Ignore storage failures; the visual toggle still works for this page view.
            }
          }
        };

        applyTheme(getStoredTheme() ?? root.dataset.theme ?? "light", false);

        document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
          button.addEventListener("click", () => {
            applyTheme(root.dataset.theme === "dark" ? "light" : "dark", true);
          });
        });
      })();
    </script>
  </body>
</html>
