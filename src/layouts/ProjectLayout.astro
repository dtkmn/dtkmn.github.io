---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectProofVisual from "@/components/ProjectProofVisual.astro";
import UiIcon from "@/components/UiIcon.astro";
import { analyticsEvents, type ProjectResourceKind } from "@/config/analytics";
import { siteConfig } from "@/config/site";
import { absoluteUrl, canonicalUrl as normalizeCanonicalUrl } from "@/lib/format";

interface EvidenceAsset {
  type: string;
  label: string;
  href?: string;
  hrefLabel?: string;
}

interface Props {
  slug: string;
  title: string;
  summary: string;
  date: Date;
  updated?: Date;
  status: "active" | "maintained" | "experimental";
  repoUrl: string;
  docsUrl?: string;
  demoUrl?: string;
  heroImage?: string;
  tags: string[];
  stack: string[];
  evidenceAssets: EvidenceAsset[];
  relatedArticles: CollectionEntry<"articles">[];
  bodyReferenceUrls: string[];
}

const {
  slug,
  title,
  summary,
  date,
  updated,
  status,
  repoUrl,
  docsUrl,
  demoUrl,
  heroImage,
  tags,
  stack,
  evidenceAssets,
  relatedArticles,
  bodyReferenceUrls,
} = Astro.props;

const pageCanonical = normalizeCanonicalUrl(Astro.url.pathname);
const authorId = absoluteUrl("/about/#author");
const projectResources = [
  { kind: "repository", label: "Repository", href: repoUrl, icon: "github" },
  ...(docsUrl ? [{ kind: "documentation", label: "Documentation", href: docsUrl, icon: "book-open" }] : []),
  ...(demoUrl ? [{ kind: "demo", label: "Demo", href: demoUrl, icon: "rocket" }] : []),
] as { kind: ProjectResourceKind; label: string; href: string; icon: "github" | "book-open" | "rocket" }[];
const shownUrls = new Set([...projectResources.map((resource) => resource.href), ...bodyReferenceUrls]);
const references = evidenceAssets.filter((asset): asset is EvidenceAsset & { href: string } => {
  if (!asset.href || shownUrls.has(asset.href)) return false;
  shownUrls.add(asset.href);
  return true;
});
const statusLabel = {
  active: "Active",
  maintained: "Maintained",
  experimental: "Experimental",
}[status];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  "@id": `${pageCanonical}#software`,
  name: title,
  description: summary,
  url: pageCanonical,
  codeRepository: repoUrl,
  dateCreated: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  keywords: tags.join(", "),
  author: {
    "@type": "Person",
    "@id": authorId,
    name: siteConfig.author.name,
    url: siteConfig.author.url,
    sameAs: siteConfig.author.sameAs,
  },
  creator: {
    "@id": authorId,
  },
  mainEntityOfPage: {
    "@id": `${pageCanonical}#webpage`,
  },
  isAccessibleForFree: true,
  image: heroImage ? [absoluteUrl(heroImage)] : undefined,
};
---

<BaseLayout title={title} description={summary} canonical={pageCanonical} image={heroImage}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

  <article class="project-shell">
    <div class="project-intro">
      <a class="project-back-link" href="/projects/">
        <UiIcon name="arrow-right" class="project-back-link-icon" />
        <span>Back to all projects</span>
      </a>
      <p class="post-kicker">Project</p>
      <h1>{title}</h1>
      <p class="post-summary">{summary}</p>

      <div class="project-meta">
        <span class:list={["status-pill", `status-pill--${status}`]}>{statusLabel}</span>
        {stack.length > 0 && <span class="project-stack">{stack.join(" / ")}</span>}
      </div>

      <div class="project-actions">
        {projectResources.map((resource) => (
          <a
            class:list={["button", resource.kind === "repository" ? "button--primary" : "button--ghost"]}
            href={resource.href}
            rel="noreferrer noopener"
            target="_blank"
            data-goatcounter-click={analyticsEvents.projectResource(slug, resource.kind)}
            data-goatcounter-title={`${title}: ${resource.kind} conversion`}
          >
            <UiIcon name={resource.icon} class="button-icon" />
            <span>{resource.label}</span>
          </a>
        ))}
      </div>
    </div>

    <ProjectProofVisual variant={slug} title={title} stack={stack} />

    <div class="prose project-copy">
      <slot />
    </div>

    {references.length > 0 && (
      <section class="project-links-section" aria-labelledby="project-references-heading">
        <h2 id="project-references-heading">References</h2>
        <ul class="project-link-list">
          {references.map((reference) => (
            <li>
              <a
                href={reference.href}
                rel="noreferrer noopener"
                target="_blank"
                data-goatcounter-click={analyticsEvents.projectEvidence(slug, reference.type)}
                data-goatcounter-title={`${title}: ${reference.label} engagement`}
              >
                {reference.hrefLabel ?? reference.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {relatedArticles.length > 0 && (
      <section class="project-links-section" aria-labelledby="project-writing-heading">
        <h2 id="project-writing-heading">Related writing</h2>
        <ul class="project-link-list">
          {relatedArticles.slice(0, 3).map((entry) => (
            <li><a href={`/posts/${entry.id}/`}>{entry.data.title}</a></li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .project-copy {
    order: 0;
  }

  .project-meta {
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
  }

  .project-stack {
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .project-links-section {
    width: min(100%, 72ch);
  }

  .project-links-section h2 {
    margin: 0 0 1rem;
    color: var(--ink-strong);
    font-family: "Newsreader Variable", serif;
    font-size: 2rem;
    line-height: 1.1;
  }

  .project-link-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding-left: 1.25rem;
    line-height: 1.6;
  }

  .project-link-list a {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    overflow-wrap: anywhere;
  }

  @media (max-width: 720px) {
    .project-shell {
      gap: 1.5rem;
      padding: 1.35rem;
    }

    .project-intro {
      gap: 0.75rem;
      padding-bottom: 1.25rem;
    }

    .project-intro .post-summary {
      max-width: 100%;
    }

    .project-actions {
      display: flex;
      padding-right: 0;
      gap: 0.6rem;
    }

    .project-actions .button {
      width: auto;
    }
  }
</style>
