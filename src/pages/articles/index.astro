---
import ArticleCard from "@/components/ArticleCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedArticles } from "@/lib/content";

const articles = await getPublishedArticles();
const canonicalArticles = articles.filter((entry) => !entry.data.canonicalUrl);
const archivedArticles = articles.filter((entry) => entry.data.canonicalUrl);
---

<BaseLayout title="Articles" description="Site-canonical essays and archived technical writing by Daniel Tse.">
  <section class="page-lead">
    <p class="eyebrow">Articles</p>
    <h1>Technical articles and essays.</h1>
    <p class="page-lead-summary">
      Essays on AI tooling, local models, backend performance, and platform engineering,
      alongside earlier tutorials originally published on Medium.
    </p>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <p class="eyebrow">Essays</p>
      <h2>Published on danieltse.org.</h2>
    </div>
    <div class="stack-grid">
      {canonicalArticles.map((entry) => <ArticleCard entry={entry} />)}
    </div>
  </section>

  {archivedArticles.length > 0 && (
    <section class="section-block section-block--quiet">
      <div class="section-heading">
        <p class="eyebrow">Archive</p>
        <h2>Earlier tutorials.</h2>
        <p class="section-summary">
          These articles retain their original publication dates and Medium links.
          Examples may require updates for current software; each article includes historical context.
        </p>
      </div>
      <div class="stack-grid">
        {archivedArticles.map((entry) => <ArticleCard entry={entry} />)}
      </div>
    </section>
  )}
</BaseLayout>
