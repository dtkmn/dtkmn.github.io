---
import ArticleCard from "@/components/ArticleCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedArticles } from "@/lib/content";

const articles = await getPublishedArticles();
const canonicalArticles = articles.filter((entry) => !entry.data.canonicalUrl);
const archivedArticles = articles.filter((entry) => entry.data.canonicalUrl);
---

<BaseLayout title="Articles" description="Site-canonical essays and archived technical writing by Daniel Tse.">
  <section class="page-lead">
    <p class="eyebrow">Articles</p>
    <h1>The arguments that belong here now.</h1>
    <p class="page-lead-summary">
      danieltse.org is the canonical home for the AI tooling, local LLM, and benchmark essays that
      match the current positioning. The older Medium-era tutorials are still available, but they
      are archive material, not the front door.
    </p>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <p class="eyebrow">Site canonical</p>
      <h2>Current essays with enough signal to carry the site.</h2>
    </div>
    <div class="stack-grid">
      {canonicalArticles.map((entry) => <ArticleCard entry={entry} />)}
    </div>
  </section>

  {archivedArticles.length > 0 && (
    <section class="section-block section-block--quiet">
      <div class="section-heading">
        <p class="eyebrow">Archive</p>
        <h2>Useful history, not flagship positioning.</h2>
        <p class="section-summary">
          These posts can stay available for continuity, but promoting them would make the site look
          smaller than the work is now.
        </p>
      </div>
      <div class="stack-grid">
        {archivedArticles.map((entry) => <ArticleCard entry={entry} />)}
      </div>
    </section>
  )}
</BaseLayout>
