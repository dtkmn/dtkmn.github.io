---
import { getCollection, render } from "astro:content";
import ProjectLayout from "@/layouts/ProjectLayout.astro";
import { getArticlesBySlugs } from "@/lib/content";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft && data.detailPage);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const bodyReferenceUrls = [...(project.body ?? "").matchAll(/\]\((https?:\/\/[^\s)]+)\)/gu)]
  .map((match) => match[1]);
const relatedArticles = await getArticlesBySlugs(project.data.relatedPosts);
---

<ProjectLayout
  slug={project.id}
  title={project.data.title}
  summary={project.data.summary}
  date={project.data.date}
  updated={project.data.updated}
  status={project.data.status}
  repoUrl={project.data.repoUrl}
  docsUrl={project.data.docsUrl}
  demoUrl={project.data.demoUrl}
  heroImage={project.data.heroImage}
  tags={project.data.tags}
  stack={project.data.stack}
  evidenceAssets={project.data.evidenceAssets}
  relatedArticles={relatedArticles}
  bodyReferenceUrls={bodyReferenceUrls}
>
  <Content />
</ProjectLayout>
