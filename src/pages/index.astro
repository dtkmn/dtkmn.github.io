---
import HomeSignalGraphic from "@/components/HomeSignalGraphic.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import UiIcon from "@/components/UiIcon.astro";
import { formatDate } from "@/lib/format";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  getFeaturedArticles,
  getFeaturedProjects,
  getPublishedArticles,
  getPublishedNotes,
  getRecentArticles,
  getRecentNotes,
} from "@/lib/content";

const [
  publishedArticles,
  publishedNotes,
  featuredArticles,
  featuredProjects,
  recentArticles,
  recentNotes,
] = await Promise.all([
  getPublishedArticles(),
  getPublishedNotes(),
  getFeaturedArticles(),
  getFeaturedProjects(3),
  getRecentArticles(4),
  getRecentNotes(4),
]);

const showNotes = recentNotes.length >= 2;
const showProjects = featuredProjects.length >= 1;
const archiveStartYear = publishedArticles.at(-1)?.data.date.getFullYear();
const latestDate = [publishedArticles[0]?.data.date, publishedNotes[0]?.data.date]
  .filter((date): date is Date => Boolean(date))
  .sort((a, b) => b.getTime() - a.getTime())[0];
const proofStats = [
  { label: "Flagship systems", value: String(featuredProjects.length), icon: "rocket" },
  { label: "Technical essays", value: String(publishedArticles.length), icon: "book-open" },
  {
    label: publishedNotes.length > 0 ? "Working notes" : "Archive from",
    value: publishedNotes.length > 0
      ? String(publishedNotes.length)
      : String(archiveStartYear ?? new Date().getFullYear()),
    icon: publishedNotes.length > 0 ? "notes" : "archive",
  },
  { label: "Last update", value: latestDate ? formatDate(latestDate) : "In flight", icon: "calendar" },
] as const;
const proofIconBySlug = {
  "mcp-zap-server": "shield",
  "rtb-ingress-benchmark": "gauge",
  "spring-boot-playground": "layers",
} as const;
const proofLedger = featuredProjects.map((project) => ({
  title: project.data.title,
  href: `/projects/${project.slug}/`,
  proof: project.data.proofPoints[0] ?? "Curated because the project has enough surface area to prove the point.",
  stack: project.data.stack.slice(0, 3).join(" / "),
  icon: proofIconBySlug[project.slug as keyof typeof proofIconBySlug] ?? "terminal",
}));
const stackSurfaces = [
  {
    title: "AI tooling",
    body: "Agents, MCP tools, local model workflows, and the security boundaries that keep experiments from becoming liabilities.",
    icon: "spark",
    href: "/projects/mcp-zap-server/",
    action: "Inspect agent tooling",
  },
  {
    title: "Backend systems",
    body: "JVM, Kotlin, Go, and runtime tradeoffs tested with harnesses instead of vibes and winner-table theater.",
    icon: "server",
    href: "/posts/what-microservice-benchmarks-actually-measure-in-2026/",
    action: "Read benchmark thinking",
  },
  {
    title: "Cloud delivery",
    body: "Service defaults, Kubernetes paths, deployment constraints, and the boring decisions that make systems survive launch day.",
    icon: "cloud",
    href: "/projects/",
    action: "Review delivery work",
  },
] as const;
const workbenchSteps = [
  {
    label: "Understand",
    title: "Map the system before touching the graph.",
    body: "The first job is exposing the real contract: dependencies, failure modes, limits, and the parts teams usually hand-wave.",
    icon: "layers",
  },
  {
    label: "Benchmark",
    title: "Make claims earn their numbers.",
    body: "Benchmarks only matter when the setup, workload, warmup, and operational context are clear enough to attack.",
    icon: "gauge",
  },
  {
    label: "Ship",
    title: "Turn sharp ideas into reusable defaults.",
    body: "The useful output is code, guardrails, templates, and release paths that other engineers can trust under pressure.",
    icon: "rocket",
  },
] as const;
const focusSignals = [
  "MCP",
  "Agent security",
  "JVM",
  "Kotlin",
  "Quarkus",
  "Go",
  "Kubernetes",
  "AWS",
  "Benchmarks",
  "Delivery paths",
] as const;
const currentWriting = recentArticles.filter((entry) => entry.data.date.getFullYear() >= 2025);
const archiveWriting = recentArticles
  .filter((entry) => entry.data.date.getFullYear() < 2025)
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero hero--home home-hero">
    <div class="hero-copy">
      <h1>Architecture<br />needs receipts.</h1>
      <p class="hero-summary">
        I turn AI tooling, backend platforms, and cloud delivery claims into systems you can
        inspect: code, benchmarks, constraints, and tradeoffs included.
      </p>
      <div class="hero-actions">
        <a class="button button--primary" href="/projects/">
          <UiIcon name="rocket" class="button-icon" />
          <span>Inspect the proof</span>
        </a>
        <a class="button button--ghost" href="/articles/">
          <UiIcon name="book-open" class="button-icon" />
          <span>Read the arguments</span>
        </a>
        <a class="button button--quiet" href="https://github.com/dtkmn" rel="noreferrer noopener" target="_blank">
          <UiIcon name="github" class="button-icon" />
          <span>Visit GitHub</span>
        </a>
      </div>
      <p class="hero-install-note">
        If there is no code, benchmark, deployment path, or hard tradeoff, it does not belong here.
      </p>
    </div>
    <aside class="hero-console" aria-label="Evidence console">
      <div class="hero-console-bar">
        <span>danieltse.org</span>
        <strong>evidence mode</strong>
      </div>
      <div class="hero-console-body">
        <p class="hero-console-command">$ inspect --with-receipts</p>
        <div class="hero-console-output">
          <span>agent tools need boundaries</span>
          <span>benchmarks need fairness controls</span>
          <span>platforms need reusable defaults</span>
        </div>
        <dl class="hero-console-grid">
          {proofStats.map((stat) => (
            <div>
              <dt>
                <UiIcon name={stat.icon} class="stat-icon" />
                <span>{stat.label}</span>
              </dt>
              <dd>{stat.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </aside>
  </section>

  <section class="home-proof-strip" aria-label="Published proof and focus areas">
    <p>Published work across</p>
    <div class="focus-marquee">
      {focusSignals.map((signal) => <span>{signal}</span>)}
    </div>
  </section>

  <section class="home-cta-band">
    <div>
      <h2>Inspect the work before you trust the claim.</h2>
      <p>Start with the systems that have code, benchmarks, deployment context, and hard tradeoffs attached.</p>
    </div>
    <a class="button button--primary" href="/projects/">
      <UiIcon name="arrow-right" class="button-icon" />
      <span>Get started</span>
    </a>
  </section>

  <section class="section-block home-section home-section--plain">
    <div class="section-heading">
      <h2>Same judgment, across the stack.</h2>
      <p class="section-summary">
        The category changes. The standard does not: find the contract, expose the limits, and make
        the tradeoff visible.
      </p>
    </div>
    <div class="stack-surface-grid">
      {stackSurfaces.map((surface) => (
        <a class="stack-surface-card" href={surface.href}>
          <span class="stack-surface-icon">
            <UiIcon name={surface.icon} />
          </span>
          <h3>{surface.title}</h3>
          <p>{surface.body}</p>
          <span class="stack-surface-link">
            <span>{surface.action}</span>
            <UiIcon name="arrow-right" />
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="section-block home-section workbench-section">
    <div class="workbench-layout">
      <div class="workbench-copy">
        <div class="section-heading">
          <h2>Put the work under pressure.</h2>
          <p class="section-summary">
            Strong engineering work follows the same standard every time: understand, benchmark,
            ship, then show the evidence.
          </p>
        </div>
        <div class="workbench-steps">
          {workbenchSteps.map((step, index) => (
            <article class:list={["workbench-step", index === 0 && "workbench-step--active"]}>
              <span class="workbench-step-label">
                <UiIcon name={step.icon} />
                {step.label}
              </span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </article>
          ))}
        </div>
      </div>
      <div class="workbench-visual">
        <HomeSignalGraphic />
      </div>
    </div>
  </section>

  <section class="section-block home-section section-block--accent">
    <div class="section-heading">
      <h2>The work has to carry the claim.</h2>
      <p class="section-summary">
        Assertions are cheap. These projects are here because they have enough implementation
        surface to be judged.
      </p>
    </div>
    <div class="proof-ledger">
      {proofLedger.map((item) => (
        <a class="proof-card" href={item.href}>
          <span class="proof-card-icon">
            <UiIcon name={item.icon} />
          </span>
          <span class="proof-card-stack">{item.stack}</span>
          <h3>{item.title}</h3>
          <p>{item.proof}</p>
          <span class="proof-card-link">
            <span>Inspect case</span>
            <UiIcon name="arrow-right" />
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="section-block home-section">
    <div class="section-heading">
      <h2>Start with the arguments behind the work.</h2>
    </div>
    <div class="feature-grid">
      {featuredArticles.map((entry) => <ArticleCard entry={entry} variant="feature" />)}
    </div>
  </section>

  {showProjects && (
    <section class="section-block home-section">
      <div class="section-heading section-heading--inline">
        <div>
          <h2>Projects with enough surface area to inspect.</h2>
        </div>
        <a class="section-link" href="/projects/">
          <span>View all projects</span>
          <UiIcon name="arrow-right" class="section-link-icon" />
        </a>
      </div>
      <div class="feature-grid">
        {featuredProjects.map((project) => <ProjectCard project={project} variant="feature" />)}
      </div>
    </section>
  )}

  <section class="section-block home-section">
    <div class="section-heading section-heading--inline">
      <div>
        <h2>Recent thinking.</h2>
      </div>
      <a class="section-link" href="/articles/">
        <span>View all articles</span>
        <UiIcon name="arrow-right" class="section-link-icon" />
      </a>
    </div>
    <div class="stack-grid">
      {(currentWriting.length > 0 ? currentWriting : recentArticles.slice(0, 2)).map((entry) => (
        <ArticleCard entry={entry} />
      ))}
    </div>
  </section>

  {archiveWriting.length > 0 && (
    <section class="section-block home-section section-block--quiet">
      <div class="section-heading section-heading--inline">
        <div>
          <p class="eyebrow">Archive</p>
          <h2>Older writeups kept for continuity, not pretending to be current.</h2>
        </div>
        <a class="section-link" href="/articles/">
          <span>Browse archive</span>
          <UiIcon name="arrow-right" class="section-link-icon" />
        </a>
      </div>
      <div class="stack-grid">
        {archiveWriting.map((entry) => <ArticleCard entry={entry} />)}
      </div>
    </section>
  )}

  {showNotes && (
    <section class="section-block home-section">
      <div class="section-heading section-heading--inline">
        <div>
          <p class="eyebrow">Recent notes</p>
          <h2>Shorter experiments, fragments, and tactical observations.</h2>
        </div>
        <a class="section-link" href="/notes/">
          <span>View notes</span>
          <UiIcon name="arrow-right" class="section-link-icon" />
        </a>
      </div>
      <div class="stack-grid">
        {recentNotes.map((entry) => <ArticleCard entry={entry} />)}
      </div>
    </section>
  )}

</BaseLayout>
