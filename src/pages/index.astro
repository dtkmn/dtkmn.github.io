---
import ProjectCard from "@/components/ProjectCard.astro";
import UiIcon from "@/components/UiIcon.astro";
import { siteConfig } from "@/config/site";
import { formatDate } from "@/lib/format";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getFeaturedArticles, getFeaturedProjects } from "@/lib/content";

const [featuredArticles, featuredProjects] = await Promise.all([
  getFeaturedArticles(),
  getFeaturedProjects(3),
]);
const selectedArticles = featuredArticles.slice(0, 3);
---

<BaseLayout>
  <section class="hero hero--home home-hero">
    <div class="hero-copy">
      <p class="eyebrow">{siteConfig.author.name} / {siteConfig.author.role}</p>
      <h1>Architecture<br />needs receipts.</h1>
      <p class="hero-summary">
        I build AI tools, backend platforms, and cloud systems, and share the code,
        benchmarks, and tradeoffs.
      </p>
      <div class="hero-actions">
        <a class="button button--primary" href="/projects/">
          <UiIcon name="rocket" class="button-icon" />
          <span>View projects</span>
        </a>
        <a class="button button--ghost" href="/about/">
          <span>About me</span>
        </a>
      </div>
    </div>
  </section>

  {featuredProjects.length > 0 && (
    <section class="section-block home-section">
      <div class="section-heading section-heading--inline">
        <h2>Selected projects.</h2>
        <a class="section-link" href="/projects/">
          <span>View all projects</span>
          <UiIcon name="arrow-right" class="section-link-icon" />
        </a>
      </div>
      <div class="project-grid home-project-grid">
        {featuredProjects.map((project) => <ProjectCard project={project} variant="feature" />)}
      </div>
    </section>
  )}

  {selectedArticles.length > 0 && (
    <section class="section-block home-section">
      <div class="section-heading section-heading--inline">
        <h2>Selected writing.</h2>
        <a class="section-link" href="/articles/">
          <span>View all articles</span>
          <UiIcon name="arrow-right" class="section-link-icon" />
        </a>
      </div>
      <div class="home-writing-list">
        {selectedArticles.map((entry) => (
          <article class="home-writing-item">
            <h3><a href={`/posts/${entry.id}/`}>{entry.data.title}</a></h3>
            <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
            <p>{entry.data.summary}</p>
          </article>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .home-hero {
    grid-template-columns: minmax(0, 1fr);
    min-height: auto;
  }

  .home-project-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .home-writing-list {
    display: grid;
  }

  .home-writing-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.6rem 1.5rem;
    padding: 1.4rem 0;
    border-top: 1px solid var(--border);
  }

  .home-writing-item h3 {
    margin: 0;
    color: var(--ink-strong);
    font-family: "Newsreader Variable", serif;
    font-size: 1.95rem;
    line-height: 1.15;
    text-wrap: balance;
  }

  .home-writing-item a:hover {
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .home-writing-item time {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .home-writing-item p {
    grid-column: 1 / -1;
    max-width: 65ch;
    margin: 0;
    color: var(--ink);
    line-height: 1.72;
  }

  @media (max-width: 960px) {
    .home-project-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .home-writing-item {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
