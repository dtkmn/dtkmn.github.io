---
import ArticleCard from "@/components/ArticleCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedNotes } from "@/lib/content";

const notes = await getPublishedNotes();
---

<BaseLayout title="Notes" description="Short technical notes and implementation fragments by Daniel Tse.">
  <section class="page-lead">
    <p class="eyebrow">Notes</p>
    <h1>Shorter field notes and implementation fragments.</h1>
    <p class="page-lead-summary">
      Brief observations and examples from implementation work.
    </p>
  </section>

  {notes.length > 0 ? (
    <div class="stack-grid">
      {notes.map((entry) => <ArticleCard entry={entry} />)}
    </div>
  ) : (
    <section class="empty-state">
      <h2>No notes published yet.</h2>
      <p>
        Browse the <a href="/articles/">articles</a> and <a href="/projects/">project guides</a>
        for published work.
      </p>
    </section>
  )}
</BaseLayout>
